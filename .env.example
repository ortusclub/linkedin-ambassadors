# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkedin_ambassadors"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# GoLogin
GOLOGIN_API_TOKEN=""

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@linkedinambassadors.com"

# File Storage (S3/R2)
S3_BUCKET_NAME=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# GitHub (for desktop app download)
GITHUB_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: workspace id for the master/ortus GoLogin account. Leave unset if master
# profiles are personal (no workspace) — shares then send no currentWorkspace param.
GOLOGIN_WORKSPACE_ID_MASTER=""
# Self-service onboarding (server-only; leave purchases off until limits are approved)
GOLOGIN_API_TOKEN_KLABBER=
PROXY_CHEAP_API_KEY=
PROXY_CHEAP_API_SECRET=
PROXY_CHEAP_AUTO_BUY=false
PROXY_CHEAP_MAX_PER_PROXY_USD=4
PROXY_CHEAP_MONTHLY_BUDGET_USD=
## Onboarding inbound email (off until migration, DNS, webhook and delivery tests pass)
ONBOARDING_EMAIL_ENABLED=false
ONBOARDING_EMAIL_FROM="LinkedVelocity <info@linkedvelocity.com>"
ONBOARDING_EMAIL_DOMAINS=
ONBOARDING_EMAIL_CODE_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=
